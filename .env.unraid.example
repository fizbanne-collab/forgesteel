# Public application address
WEB_ORIGIN=https://drawsteel.crawfords.work
GOOGLE_CALLBACK_URL=https://drawsteel.crawfords.work/api/auth/google/callback
COOKIE_SECURE=true
WEB_PORT=32500

# Unraid persistence
APPDATA_PATH=/mnt/user/appdata/stravsteel
BACKUP_PATH=/mnt/user/backups/stravsteel

# Generate unique production secrets before deployment
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_ADMIN_EMAIL=

# API and backup policy
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
