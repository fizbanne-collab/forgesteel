{
	"name": "stravsteel",
	"private": true,
	"version": "14.112.0",
	"type": "module",
	"repository": "https://github.com/fizbanne-collab/forgesteel.git",
	"scripts": {
		"start": "vite --host",
		"start:api": "tsx watch server/src/index.ts",
		"start:all": "concurrently -n web,api -c blue,green \"npm:start\" \"npm:start:api\"",
		"db:migrate": "tsx server/src/migrate.ts",
		"check:api": "tsc -p server/tsconfig.json --noEmit",
		"build:api": "tsc -p server/tsconfig.json",
		"update": "npx npm-check-updates --peer --interactive --format group",
		"lint": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --concurrency auto --fix",
		"test": "vitest",
		"check": "npm run lint && tsc -p tsconfig.json && npm run check:api && vitest run && npm audit",
		"build": "vite build"
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.1",
		"@dnd-kit/core": "^6.3.1",
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@fastify/multipart": "^10.0.0",
		"@fastify/rate-limit": "^11.1.0",
		"@fastify/websocket": "^11.2.0",
		"@mdxeditor/editor": "^4.0.4",
		"@types/showdown": "^2.0.6",
		"antd": "^6.4.5",
		"axios": "^1.18.1",
		"dotenv": "^17.4.2",
		"fast-json-patch": "^3.1.1",
		"fastify": "^5.9.0",
		"html2canvas": "^1.4.1",
		"jose": "^6.2.3",
		"jspdf": "^4.2.1",
		"localforage": "^1.10.0",
		"modern-screenshot": "^4.7.0",
		"pdf-lib": "^1.17.1",
		"pg": "^8.22.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8.0.1",
		"sass": "^1.101.0",
		"showdown": "^2.1.0",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/gtag.js": "^0.0.20",
		"@types/node": "^26.0.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.9",
		"axios-mock-adapter": "^2.1.0",
		"concurrently": "^10.0.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"globals": "^17.7.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.0",
		"vitest": "^4.1.9"
	}
}
